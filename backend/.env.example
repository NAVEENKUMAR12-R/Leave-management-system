# ==========================================
# Supabase PostgreSQL Configuration Template
# ==========================================
# 1. Go to your Supabase Dashboard: https://supabase.com/dashboard
# 2. Select your project -> Project Settings -> Database
# 3. Under "Connection string", select "JDBC" or "URI".
#
# Recommended for cloud hosting (Render, Koyeb, etc.):
# Use the Supavisor connection pooler (Session mode, port 5432) because free hosting platforms
# require IPv4 support which the pooler provides.
#
# Format:
# DATABASE_URL=jdbc:postgresql://<HOST>:5432/postgres?sslmode=require
# DATABASE_USERNAME=postgres.<PROJECT_REF>
# DATABASE_PASSWORD=<YOUR_DATABASE_PASSWORD>

DATABASE_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.your_project_ref
DATABASE_PASSWORD=your_db_password

# Port (defaults to 8080 locally, cloud providers set this automatically)
PORT=8080
